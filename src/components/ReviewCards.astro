---
import Icon from './Icon.astro';
import {reviews} from '../data/evidence';
interface Props { excerpts?: boolean }
const {excerpts = false} = Astro.props;
---
<div class="review-grid">{reviews.map(review => <article class="review-card">
  <div class="review-meta"><span>{review.topic}</span><span class="review-stars" role="img" aria-label={`${review.stars} out of 5 stars`}>★★★★★</span></div>
  {excerpts ? <blockquote><p>“{review.excerpt}”</p></blockquote> : <p class="review-summary">{review.summary}</p>}
  <div class="review-author"><span class="review-avatar" aria-hidden="true">{review.name.charAt(0)}</span><div><strong>{review.name}</strong><span>Google review{excerpts ? ' excerpt' : ''}</span></div><a class="text-link" href={review.url} target="_blank" rel="noopener noreferrer" aria-label={`Read ${review.name}’s original review on Google`}>Original<Icon name="diagonal" size={14}/></a></div>
</article>)}</div>
