---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import {clinic} from '../data/clinic';
import {doctor, reviewSnapshot} from '../data/evidence';
---
<Layout title="About 32 Whites Dental Clinic | Keshavnagar, Pune" description={`Get to know ${clinic.name} at Arc Pukhraj, Keshavnagar. Meet Dr. Bhakti, explore public reviews and plan a visit.`} pageType="AboutPage" breadcrumbs={[{name:'Our clinic',path:'/about/'}]}>
  <div class="container"><section class="page-hero page-hero-wide"><span class="eyebrow">Your neighbourhood dental clinic</span><h1>Your neighbourhood.<br/><span class="soft-text">Your next dental visit.</span></h1><p>{clinic.name} is at {clinic.address}. A place to start with a toothache, keep up with check-ups or plan a change to your smile. Meet the dentist, see public patient reviews and check the details that make your visit easier.</p></section><section class="about-grid section-sm"><div class="about-photo"><img src="/images/clinic-720.webp" srcset="/images/clinic-360.webp 360w, /images/clinic-640.webp 640w, /images/clinic-720.webp 720w, /images/clinic-960.webp 960w" sizes="(max-width:767px) 92vw, 45vw" width="720" height="960" alt="32 Whites Dental Clinic sign and entrance at Arc Pukhraj, Keshavnagar"/><div class="photo-note"><strong>Find the entrance</strong><span>Opposite Renuka Mata Mandir</span></div></div><div><span class="eyebrow">Meet your dentist</span><h2>{doctor.name}</h2><dl class="credential-list doctor-summary"><div><dt>Qualification</dt><dd>Bachelor of Dental Surgery · BDS</dd></div><div><dt>Dental college</dt><dd>{doctor.college}</dd></div><div><dt>Registration</dt><dd>{doctor.council} · <strong>{doctor.registration}</strong></dd></div></dl><a class="text-link" href={doctor.profile}>Qualifications & your consultation<Icon name="arrow" size={16}/></a></div></section><section class="section-sm"><div class="section-heading"><h2>A clinic you can get to know before you arrive</h2></div><div class="guide-grid"><article class="guide-card"><h3><a href="/reviews/">Hear from people who’ve visited</a></h3><p>Google showed {reviewSnapshot.rating}/5 from {reviewSnapshot.count} reviews when checked on {reviewSnapshot.checked}.</p><span class="text-link" aria-hidden="true">Review sources & context<Icon name="arrow" size={16}/></span></article><article class="guide-card"><h3><a href="/our-work/">See what the clinic has shared</a></h3><p>Explore original clinic posts about treatment cases and instrument sterilisation.</p><span class="text-link" aria-hidden="true">Read clinical updates<Icon name="arrow" size={16}/></span></article><article class="guide-card"><h3><a href="/contact/">Find a time that fits your week</a></h3><p>Open seven days a week. English, Hindi and Marathi. Parking available; access involves stairs.</p><span class="text-link" aria-hidden="true">Hours, directions & appointments<Icon name="arrow" size={16}/></span></article></div></section><section class="section-sm narrow"><h2 class="subheading">A treatment choice starts with your teeth</h2><p>A procedure name alone cannot tell you what your mouth needs. Our guides explain what treatment does, when it may fit and the risks, alternatives, cost factors and ongoing care to discuss with your dentist.</p><div class="filter-links"><a href="/services/">Explore treatments</a><a href="/concerns/">Start with a concern</a><a href="/pricing/">Discuss costs</a><a href="/blog/">Patient guides</a></div></section></div>
</Layout>
