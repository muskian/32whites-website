---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import {symptoms} from '../data/symptoms';
import {concerns} from '../data/discovery';
import {whatsappBookingUrl} from '../data/clinic';
const bookingUrl = whatsappBookingUrl('/concerns/');
---
<Layout title="Dental Concerns & Where to Start | 32 Whites, Keshavnagar" description="Find information on tooth pain, sensitive teeth, swollen gums, a broken tooth and dental anxiety. Prepare for an assessment at 32 Whites in Keshavnagar." pageType="CollectionPage" breadcrumbs={[{name:'Dental concerns',path:'/concerns/'}]}>
  <div class="container"><section class="page-hero page-hero-wide"><span class="eyebrow">Start with what you’re experiencing</span><h1>Something feels different?<br/><span class="soft-text">Start with what you’ve noticed.</span></h1><p>A sore tooth, blood when brushing, a chipped edge or a worry about visiting the dentist: you don’t need to know the treatment name. Find what sounds familiar, check when to seek help and arrange an examination to establish the cause.</p></section><div class="guide-grid">{symptoms.map(item => <article class="guide-card"><h2 class="guide-title"><a href={`/symptoms/${item.slug}/`}>{item.name}</a></h2><p>{item.intro}</p><span class="text-link" aria-hidden="true">What to do next<Icon name="arrow" size={16}/></span></article>)}</div><section class="section-sm"><h2 class="subheading">Thinking about a gap, alignment or your child’s care?</h2><nav class="filter-links" aria-label="Explore care options">{concerns.filter(item => item.icon === 'implant' || item.icon === 'align' || item.icon === 'child' || item.icon === 'spark').map(item => <a href={item.href}>{item.title}</a>)}</nav></section><section class="notice notice-urgent"><h2 class="notice-title"><Icon name="alert" size={20}/>When you need help sooner</h2><p>Difficulty breathing or swallowing, serious injury or rapidly worsening swelling needs emergency medical help. Do not wait for an online reply.</p><a class="text-link" href="/services/emergency-dental/">Read about urgent dental care<Icon name="arrow" size={16}/></a></section><section class="section-sm"><a class="button button-dark" href={bookingUrl} target="_blank" rel="noopener noreferrer" data-track="whatsapp_booking_click"><Icon name="chat" size={18}/>Book on WhatsApp</a></section></div>
</Layout>
